# Copy to backend/.env for local development. Never commit the real .env.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://nav:nav@localhost:5432/navigator

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"  (also stored as a GitHub Actions secret)
INTERNAL_SYNC_SECRET=

# GitHub OAuth App: see docs/GITHUB_SETUP.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user repo read:project
# Your numeric GitHub user id (https://api.github.com/users/<your-login> -> "id")
ALLOWED_GITHUB_USER_IDS=

# Local only: sign in without GitHub
DEV_LOGIN_ENABLED=true

# Documents: "local" for development, "supabase" in production
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
MAX_UPLOAD_MB=15
